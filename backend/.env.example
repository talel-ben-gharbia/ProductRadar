### Backend environment example for local development
# Copy this to `.env.local` or export variables before starting the server.
# Replace values with your local configuration where necessary.

# Firebase web API key used by server-side provisioning endpoints
FIREBASE_WEB_API_KEY=AIzaSyBHztYA2cs7XtsOsu1gFWOKzBeT6R2gRG4

# Gmail SMTP for approval success emails
# Use a Gmail App Password, not your normal account password.
# Example:
# MAILER_DSN=smtp://your-gmail-address%40gmail.com:your-app-password@smtp.gmail.com:587?encryption=tls

# From address used by approval emails
B2B_NOTIFICATIONS_FROM=talelbengharbia213@gmail.com

# Symfony example settings
APP_ENV=dev
DATABASE_URL="postgresql://postgres:0000@127.0.0.1:5432/productRadar?serverVersion=18&charset=utf8"
